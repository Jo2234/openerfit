# Bind address; Render uses 0.0.0.0 via Dockerfile.
HOST=127.0.0.1
# Listening port; Render injects its own PORT.
PORT=5188
# Enable only behind a trusted proxy that appends the real client IP.
TRUST_PROXY=0
# Enable production SPA serving with production.
NODE_ENV=development
# Qloo mode: fixture (default) or live; a key alone never enables live.
QLOO_MODE=fixture
# Qloo credential, required only for live mode; never commit a real value.
QLOO_API_KEY=
# Live Qloo host; HTTP 127.0.0.1 is supported only for local stubs.
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Private response-cache directory; use /tmp/qloo-cache on Render (ephemeral).
QLOO_CACHE_DIR=.cache/qloo
# Cache retention in hours (0–87600).
QLOO_CACHE_TTL_HOURS=168
# Response cache toggle: on or off.
QLOO_CACHE=on
# Writer mode: none, fixture, or openai-compatible.
LLM_MODE=none
# Provider base URL, required for openai-compatible mode.
LLM_BASE_URL=
# Provider model name, required for openai-compatible mode.
LLM_MODEL=
# Optional provider credential; never commit a real value.
LLM_API_KEY=
# LLM request timeout in milliseconds (1–600000).
LLM_TIMEOUT_MS=180000
# llama.cpp compatibility toggle: 0 or 1.
LLM_LLAMACPP=0
# Seed compatibility: 0 omits seed, 1 sends deterministic seed 42 (default).
LLM_SUPPORTS_SEED=1
# Optional reasoning effort: none|minimal|low|medium|high; empty means unset.
# LLM_REASONING_EFFORT=none
# Per-call token caps (integers 64–16384).
LLM_PLANNER_MAX_TOKENS=300
LLM_WRITER_MAX_TOKENS=1200
LLM_BASELINE_MAX_TOKENS=900
# Optional deployment commit identifier reported by health (takes precedence).
GIT_SHA=
# Render-provided deployment commit used when GIT_SHA is empty.
RENDER_GIT_COMMIT=
